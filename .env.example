# Do not put PHI or credentials in source control.
DATABASE_URL=postgresql+psycopg://medical:medical@postgres:5432/medical_records
STORAGE_ROOT=./data
OUTPUT_ROOT=./output
CONFIDENCE_HIGH=0.90
CONFIDENCE_MEDIUM=0.70
HIGH_RISK_CONFIDENCE=0.98
ARCHIVE_MAX_FILES=1000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000
ARCHIVE_MAX_SINGLE_FILE_BYTES=104857600
ARCHIVE_MAX_COMPRESSION_RATIO=1000
ARCHIVE_EXTRACTION_TIMEOUT_SECONDS=120
ALLOW_NESTED_ARCHIVE_EXTRACTION=false
AI_EXTRACTION_PROVIDER=local_safe
# Set AI_PROVIDER=openai, openrouter, or local; leave it empty to use AI_EXTRACTION_PROVIDER.
# AI_PROVIDER=openai
# AI_PROVIDER=openrouter
AI_EXTRACTION_MODE=patient_level
LEGACY_OCR_ENABLED=false
# Configure a validated OCR / multimodal provider only after a privacy review.
# Keep this value only in an untracked local secret store; never commit it or pass it to frontend.
# AI_EXTRACTION_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MEDICAL_MODEL=gpt-5.6-sol
# OPENAI_REASONING_MODEL=gpt-5.6-sol
# OPENAI_SUMMARY_MODEL=gpt-5.6-sol
# OPENAI_IMAGE_DETAIL=high
# AI_ALLOW_HIERARCHICAL_FALLBACK=true
# AI_MAX_PATIENT_BYTES=41943040
# FAST_MODEL_MIN_CONFIDENCE=0.80
# AUTO_ACCEPT_CONFIDENCE=0.95
# PHYSICIAN_REVIEW_CONFIDENCE=0.70
# AI_MAX_CONCURRENT_REQUESTS=4
# AI_REQUEST_TIMEOUT_SECONDS=90
# AI_MAX_RETRIES=2
# AI_PAGES_PER_REQUEST=3
# AI_DEBUG=true
# APP_ENV=development
# ADMIN_MODE=false
# OPENAI_PROMPT_ROOT=./prompts/openai
# OpenRouter is OpenAI-compatible; never commit this key.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama provider: no API key and no cloud fallback.
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://host.docker.internal:11434
# LOCAL_AI_MODEL=qwen3-vl
# LOCAL_OCR_ENABLED=false
